# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BillSwipe

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/billswipe

# Authentication (NextAuth.js or similar)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment Processing (Stripe recommended)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# File Storage (AWS S3 or similar)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=billswipe-documents
AWS_REGION=us-east-1

# Email Service (SendGrid, AWS SES, etc.)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@billswipe.com

# Verification Service (Custom or third-party)
VERIFICATION_API_KEY=your-verification-api-key

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# Monitoring & Error Tracking
SENTRY_DSN=your-sentry-dsn

# Feature Flags
ENABLE_SOCIAL_LOGIN=true
ENABLE_RECURRING_DONATIONS=false
MAINTENANCE_MODE=false
